---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Card, Pagination } from 'accessible-astro-components'
import type { PaginateFunction, Page } from 'astro'
import { getAllBlogPosts, type BlogPost } from '@utils/wordpress'

interface Post extends BlogPost {}

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  try {
    const posts = await getAllBlogPosts(100)
    return paginate(posts, { pageSize: 6 })
  } catch (error) {
    throw new Error(`Failed to fetch blog posts from WordPress GraphQL: ${String(error)}`)
  }
}

interface Props {
  page: Page<Post>
}

const { page } = Astro.props as Props
---

<DefaultLayout
  title="Blog"
  description="A blog powered by production WordPress GraphQL content."
>
  <PageHeader
    title="Blog"
    subtitle='This blog is powered by content fetched from the production <a href="https://uainclusive.getquick.io/graphql">WordPress GraphQL endpoint</a>.'
    bgType="bordered"
  />

  <section class="my-12">
    <div class="container">
      <p class="text-sm"><em>Post {page.start + 1} through {page.end + 1} of {page.total} total posts</em></p>
      <ul class="my-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((post) => (
            <li>
              <Card
                image={post.imagePath}
                url={'/blog/' + post.slug}
                title={post.shortTitle}
                headingLevel="h2"
                footer={post.authorName}
                fullHeight={true}
              >
                {post.excerptText}
              </Card>
            </li>
          ))
        }
      </ul>
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? '/blog' : null}
              previousPage={page.url.prev ? page.url.prev : null}
              nextPage={page.url.next ? page.url.next : null}
              lastPage={page.url.next ? `/blog/${page.lastPage}` : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel="Blog pagination"
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>
