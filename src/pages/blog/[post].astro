---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import sanitizeHtml from 'sanitize-html'
import { getAllBlogPosts, type BlogPost } from '@utils/wordpress'

interface Props {
  post: BlogPost
}

export async function getStaticPaths() {
  try {
    const posts = await getAllBlogPosts(100)
    return posts.map((post) => ({
      params: { post: post.slug },
      props: { post },
    }))
  } catch (error) {
    throw new Error(`Failed to fetch blog posts from WordPress GraphQL: ${String(error)}`)
  }
}

const { post } = Astro.props as Props
const postSlug = Astro.params.post ?? post.slug
const canonicalUrl = new URL(`/blog/${postSlug}`, Astro.site ?? Astro.url).href
const sanitizedContent = sanitizeHtml(post.contentHtml || post.excerptHtml, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6']),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    a: ['href', 'name', 'target', 'rel'],
    img: ['src', 'alt', 'title', 'width', 'height', 'loading'],
  },
})
const author = {
  name: post.authorName,
  image: '/posts/post-image-1.png',
  bio: 'WordPress author',
}
---

<DefaultLayout title={post.title} description={post.excerptText} url={canonicalUrl}>
  <PageHeader
    title={post.title}
    subtitle={post.excerptHtml}
    author={author}
    bgType="bordered"
    featuredImage={post.imagePath}
  />
  <section class="my-12">
    <div class="narrow space-content container">
      <Heading level="h2">Article</Heading>
      <div class="space-content" set:html={sanitizedContent} />
    </div>
  </section>
  <section class="my-12">
    <div class="narrow space-content container">
      <Heading level="h2">Share this post</Heading>
      <p>Like this post? Share it with your friends!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>
